    },
    {
     "key": "s1.130",
     "kind": "text",
     "value": "From Data Discovery to Demonstrable Compliance."
    },
    {
     "key": "s1.131",
     "kind": "text",
     "value": "DPDP Compliance Lifecycle"
    },
    {
     "key": "s1.132",
     "kind": "text",
     "value": "Discover"
    },
    {
     "key": "s1.133",
     "kind": "text",
     "value": "Identify personal data, systems, applications and processors."
    },
    {
     "key": "s1.134",
     "kind": "text",
     "value": "Assess"
    },
    {
     "key": "s1.135",
     "kind": "text",
     "value": "Understand purposes, lawful basis, risks and compliance gaps."
    },
    {
     "key": "s1.136",
     "kind": "text",
     "value": "Implement"
    },
    {
     "key": "s1.137",
     "kind": "text",
     "value": "Deploy the required privacy, security and governance controls."
    },
    {
     "key": "s1.138",
     "kind": "text",
     "value": "Integrate"
    },
    {
     "key": "s1.139",
     "kind": "text",
     "value": "Connect DPDP controls with your business applications."
    },
    {
     "key": "s1.140",
     "kind": "text",
     "value": "Monitor"
    },
    {
     "key": "s1.141",
     "kind": "text",
     "value": "Track compliance, risks, incidents, rights and remediation."
    },
    {
     "key": "s1.142",
     "kind": "text",
     "value": "Audit & Improve"
    },
    {
     "key": "s1.143",
     "kind": "text",
     "value": "Maintain evidence, assess controls and continuously improve."
    },
    {
     "key": "s1.144",
     "kind": "text",
     "value": "Why Choose Us?"
    },
    {
     "key": "s1.145",
     "kind": "text",
     "value": "Technology + Compliance + Business Process"
    },
    {
     "key": "s1.146",
     "kind": "text",
     "value": "DPDP compliance cannot be addressed through documentation alone."
    },
    {
     "key": "s1.147",
     "kind": "text",
     "value": "Our approach combines:"
    },
    {
     "key": "s1.148",
     "kind": "text",
     "value": "Regulatory Understanding"
    },
    {
     "key": "s1.149",
     "kind": "text",
     "value": "Business Process"
    },
    {
     "key": "s1.150",
     "kind": "text",
     "value": "Technology"
    },
    {
     "key": "s1.151",
     "kind": "text",
     "value": "Security"
    },
    {
     "key": "s1.152",
     "kind": "text",
     "value": "Automation"
    },
    {
     "key": "s1.153",
     "kind": "text",
     "value": "Governance"
    },
    {
     "key": "s1.154",
     "kind": "text",
     "value": "Continuous Monitoring"
    },
    {
     "key": "s1.155",
     "kind": "text",
     "value": "This enables organisations to move beyond a static compliance programme and build an"
    },
    {
     "key": "s1.156",
     "kind": "text",
     "value": "operational privacy framework integrated into their everyday business processes and technology landscape."
    },
    {
     "key": "s1.157",
     "kind": "text",
     "value": "Start Your DPDP Journey"
    },
    {
     "key": "s1.158",
     "kind": "text",
     "value": "Not sure where your organisation stands?"
    },
    {
     "key": "s1.159",
     "kind": "text",
     "value": "We can help you assess your current DPDP readiness, identify technology and process gaps, and develop a practical implementation roadmap."
    },
