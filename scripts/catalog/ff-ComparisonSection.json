    },
    {
     "key": "compar-s1.5",
     "kind": "text",
     "value": "Proprietary SaaS models enforce 'per-user' licensing penalties."
    },
    {
     "key": "compar-s1.6",
     "kind": "text",
     "value": "Black-box code creates vendor lock-in and hinders customization."
    },
    {
     "key": "compar-s1.7",
     "kind": "text",
     "value": "The Frappe Advantage"
    },
    {
     "key": "compar-s1.8",
     "kind": "text",
     "value": "100% Open Source:"
    },
    {
     "key": "compar-s1.9",
     "kind": "text",
     "value": " No vendor lock-in; you own your data and code."
    },
    {
     "key": "compar-s1.10",
     "kind": "text",
     "value": "Unified Truth:"
    },
    {
     "key": "compar-s1.11",
