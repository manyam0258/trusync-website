/**
 * Full default content for pages that started as a template or a one-line placeholder:
 * the services TruSync offers (consulting, implementation, development, migration, mobile apps, training),
 * the Frappe products it implements (Helpdesk, LMS, Insights), open-source integrations, and two industries.
 *
 * Each page uses the standard site sections, so editors can change every word in the admin.
 * Product facts follow the official Frappe documentation (docs.frappe.io). Keep claims factual:
 * no client counts, timelines or certifications that TruSync cannot back up.
 */
import type { Seed } from './seed-pages.mjs'

type Icon =
  | 'Award' | 'Banknote' | 'Briefcase' | 'Building2' | 'CheckCircle2' | 'Clock' | 'Cloud' | 'Code' | 'Cpu' | 'Database'
  | 'Factory' | 'FileText' | 'Globe' | 'GraduationCap' | 'HardHat' | 'Headphones' | 'Layout' | 'LineChart' | 'Lock' | 'Phone'
  | 'Settings' | 'ShieldCheck' | 'ShoppingCart' | 'Sliders' | 'Smartphone' | 'Star' | 'Stethoscope' | 'Truck' | 'TrendingUp'
  | 'UserCheck' | 'Users' | 'Wheat' | 'Zap'
type Color = 'blue' | 'purple' | 'orange' | 'green' | 'indigo' | 'teal' | 'red' | 'pink' | 'yellow'

type Content = {
  slug: string; title: string; metaTitle: string; metaDescription: string
  eyebrow: string; heading: string; sub: string
  pains: [string, string][]
  capsHeading: string; capsIntro: string; caps: [string, string, Icon][]
  howEyebrow?: string; howHeading: string; howBody: string; steps: [string, string][]; badge: [string, string]
  listHeading: string; list: string[]
  tech: string[]
  faqs: [string, string][]
  ctaHeading: string; ctaBody: string
}

const COLORS: Color[] = ['blue', 'purple', 'teal', 'orange', 'green', 'indigo']
const BADGE_ICONS: Icon[] = ['Code', 'Cpu', 'Database', 'Cloud']

const toSeed = (c: Content): Seed => ({
  slug: c.slug,
  title: c.title,
  metaTitle: c.metaTitle,
  metaDescription: c.metaDescription,
  noindex: false,
  layout: async ({ md }) => [
    { blockType: 'hero', variant: 'dark', eyebrow: c.eyebrow, heading: c.heading, subheading: c.sub,
      primaryCta: { label: 'Book a Free Consultation', url: '#contact' }, secondaryCta: { label: 'See what is included', url: '#features' } },
    { blockType: 'features', cardStyle: 'problem', theme: 'light', columns: '3',
      eyebrow: 'The problem', heading: 'Where teams get stuck',
      items: c.pains.map(([title, description]) => ({ title, description })) },
    { blockType: 'features', cardStyle: 'icon', theme: 'white', columns: '3', anchor: 'features',
      eyebrow: 'What you get', heading: c.capsHeading, intro: c.capsIntro,
      items: c.caps.map(([title, description, icon], i) => ({ title, description, icon, color: COLORS[i % COLORS.length] })) },
    { blockType: 'imageText', theme: 'light', imageSide: 'right', eyebrow: c.howEyebrow ?? 'How we work', heading: c.howHeading,
      body: await md(c.howBody), items: c.steps.map(([title, description]) => ({ title, description })),
      badgeTitle: c.badge[0], badgeText: c.badge[1] },
    { blockType: 'features', cardStyle: 'checklist', theme: 'white', columns: '2',
      heading: c.listHeading, items: c.list.map((title) => ({ title })) },
    { blockType: 'badges', heading: 'Built on open-source technology',
      items: c.tech.map((label, i) => ({ label, icon: BADGE_ICONS[i % BADGE_ICONS.length] })) },
    { blockType: 'faq', heading: 'Frequently asked questions', items: c.faqs.map(([question, answer]) => ({ question, answer })) },
    { blockType: 'cta', theme: 'blue', heading: c.ctaHeading, body: c.ctaBody, button: { label: 'Book Free Consultation', url: '#contact' } },
    { blockType: 'contactForm' },
  ],
})

