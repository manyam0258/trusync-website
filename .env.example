# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
PAYLOAD_SECRET=generate-with-openssl-rand-hex-32
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret that lets the admin Preview button open unpublished drafts. Use a long random value.
PREVIEW_SECRET=generate-with-openssl-rand-hex-32
# Contact form: enquiries are saved to the Supabase table "contact", then sent to Telegram and an n8n webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
N8N_WEBHOOK_URL=
# DPDP consent widget on the contact form.
NEXT_PUBLIC_SENTINEL_URL=
SENTINEL_BACKEND_URL=
